#!/usr/bin/env bash
# camera-simples - gerencia a tela da PrimeSense (Camera_Simples.py: RGB em
# tela cheia + profundidade em miniatura + bounding box de rosto via YOLO)
# na tela fisica da Jetson (HDMI). O numero do DISPLAY (:0, :1, ...) muda
# conforme o boot, entao e detectado automaticamente a partir do socket X
# ativo em /tmp/.X11-unix (fallback pra :0 se nada for encontrado).
#
#   ./camera-simples            reinicia (para + reseta USB + abre de novo)
#   ./camera-simples start      so abre (nao mexe em processo/USB antes)
#   ./camera-simples stop       fecha e libera o sensor
#   ./camera-simples status     mostra se esta rodando
#   ./camera-simples usb [s]    so espera a PrimeSense aparecer no USB (padrao 60 s)
#
# Antes de abrir o app ele ESPERA a PrimeSense aparecer no USB (e ficar estavel
# por 2 s), mostrando "Procurando a PrimeSense no USB... tentativa N" — assim um
# cabo desplugado/replugando nao vira "sensor nao abriu" depois de 25 s de silencio.
# CAMERA_ESPERA_USB_S=90 muda o tempo maximo de espera.
#
# Qualquer argumento extra e repassado pro Camera_Simples.py, ex:
#   ./camera-simples start --no-faces      desliga a deteccao de rosto
#   ./camera-simples start --face-size 128 deteccao mais rapida/menos precisa
#
# Por que precisa disso em vez de so matar o processo: nessa Jetson o sensor
# PrimeSense fica travado se o app morrer sem fechar os streams (visto na
# pratica: a proxima abertura pendura, e o audio USB para de aceitar 48 kHz).
# Por isso o encerramento e em 2 tempos: SIGTERM primeiro (o app fecha os
# streams sozinho, ~4 s, sem reset USB); so se nao sair em 10 s vai de -9 e
# reset USB por software (ioctl USBDEVFS_RESET). Cuidado: o reset USB pode
# deixar a profundidade/o mic mortos ate um replug fisico do cabo — por isso
# ele so acontece quando o -9 foi necessario ou a abertura falhou.
set -u

DISP_NUM="$(ls /tmp/.X11-unix/ 2>/dev/null | sed -n 's/^X//p' | head -n1)"
DISP=":${DISP_NUM:-0}"
APPDIR="$HOME/dev/LSA_robot/experiments/camera_prime_sense"
# runtime do OpenNI2 extraido do .deb (sem sudo); Camera_Simples.py le OPENNI2_REDIST
[ -d "$HOME/dev/openni2-redist" ] && export OPENNI2_REDIST="$HOME/dev/openni2-redist"
PY="$APPDIR/venv/bin/python"
APP="$APPDIR/Camera_Simples.py"
LOG="/tmp/camera-simples.log"
USB_VENDOR="${CAMERA_USB_VENDOR:-1d27}"      # so pra testes: outro id simula a camera ausente
USB_PRODUCT="0601"
ESPERA_USB_S="${CAMERA_ESPERA_USB_S:-60}"    # quanto esperar a PrimeSense aparecer no USB
ESTAVEL_USB_S=2                              # segundos seguidos presente pra valer como estavel

for f in "$HOME/.Xauthority" "/run/user/$(id -u)/gdm/Xauthority"; do
    [ -f "$f" ] && { export XAUTHORITY="$f"; break; }
done
export DISPLAY="$DISP"

achar_dispositivo_usb() {
    local d vendor product bus dev
    for d in /sys/bus/usb/devices/*/; do
        vendor="$(cat "${d}idVendor" 2>/dev/null)"
        product="$(cat "${d}idProduct" 2>/dev/null)"
        if [ "$vendor" = "$USB_VENDOR" ] && [ "$product" = "$USB_PRODUCT" ]; then
            bus="$(cat "${d}busnum" 2>/dev/null)"
            dev="$(cat "${d}devnum" 2>/dev/null)"
            [ -n "$bus" ] && [ -n "$dev" ] && printf '/dev/bus/usb/%03d/%03d\n' "$bus" "$dev" && return 0
        fi
    done
    return 1
}

# Progresso: em terminal sobrescreve a mesma linha; fora dele (log, pipe) imprime
# uma linha nova a cada ~5 s. `fim_progresso` apaga a linha de progresso.
progresso() {   # progresso <texto> <segundos decorridos>
    if [ -t 1 ]; then printf '\r\033[K%s' "$1"
    elif [ $(( $2 % 5 )) -eq 0 ]; then echo "$1"; fi
}
fim_progresso() { if [ -t 1 ]; then printf '\r\033[K'; fi; }

# Espera a PrimeSense aparecer no USB e ficar ESTAVEL_USB_S segundos seguidos
# (ela as vezes aparece e cai). Devolve 1 se nao aparecer em `limite` segundos.
esperar_usb() {   # esperar_usb [limite em segundos]
    local limite="${1:-$ESPERA_USB_S}" inicio=$SECONDS tentativa=0 seguidos=0 dec texto
    while :; do
        dec=$((SECONDS - inicio))
        if achar_dispositivo_usb >/dev/null; then
            seguidos=$((seguidos + 1))
            if [ "$seguidos" -ge "$ESTAVEL_USB_S" ]; then
                fim_progresso
                echo "PrimeSense encontrada no USB."
                return 0
            fi
            texto="PrimeSense detectada no USB, confirmando..."
        else
            seguidos=0
            texto="Procurando a PrimeSense no USB... tentativa $((tentativa + 1)) (${dec}s/${limite}s) - se nao aparecer, replugue o cabo"
        fi
        [ "$dec" -ge "$limite" ] && break
        tentativa=$((tentativa + 1))
        progresso "$texto" "$dec"
        sleep 1
    done
    fim_progresso
    echo "ERRO: a PrimeSense nao apareceu no USB em ${limite}s." >&2
    echo "      Replugue o cabo (10 s desplugado, direto numa porta da Jetson, sem hub) e tente de novo." >&2
    return 1
}

resetar_usb() {
    local caminho
    caminho="$(achar_dispositivo_usb)" || { echo "AVISO: PrimeSense nao encontrada no USB (pulei o reset)." >&2; return 0; }
    python3 -c "
import fcntl, os, sys
try:
    fd = os.open('$caminho', os.O_WRONLY)
    fcntl.ioctl(fd, 0x5514, 0)  # USBDEVFS_RESET
    os.close(fd)
except Exception as e:
    print(f'AVISO: falha ao resetar USB ({e})', file=sys.stderr)
"
    sleep 2
}

status() {
    if pgrep -f "$APP" >/dev/null 2>&1; then
        echo "rodando (pid $(pgrep -f "$APP" | tr '\n' ' '))"
    else
        echo "parado"
    fi
}

# Encerra o app. Primeiro SIGTERM: o Camera_Simples.py trata o sinal e fecha os
# streams do OpenNI2 no 'finally' (~4 s), o que deixa o sensor limpo — sem
# reset USB. So se o processo nao sair em TIMEOUT_TERM_S (travado no OpenNI2/GTK)
# vai de -9, e af sim o sensor fica sujo e precisa do reset USB. Com
# "parar reset" (usado nas retentativas de abertura) o reset USB e sempre feito.
TIMEOUT_TERM_S=10
parar() {
    local forcar_reset="${1:-}" sujo=0 i
    if pgrep -f "$APP" >/dev/null 2>&1; then
        pkill -TERM -f "$APP" 2>/dev/null
        for i in $(seq 1 "$TIMEOUT_TERM_S"); do
            sleep 1
            pgrep -f "$APP" >/dev/null 2>&1 || break
        done
        if pgrep -f "$APP" >/dev/null 2>&1; then
            echo "app nao saiu com SIGTERM em ${TIMEOUT_TERM_S}s; matando com -9 (vai precisar de reset USB)." >&2
            pkill -9 -f "$APP" 2>/dev/null
            sujo=1
        fi
    fi
    # orfaos: o filho da deteccao de rosto (multiprocessing.spawn), o
    # semaphore_tracker e o worker do Vosk. Num encerramento limpo ja saíram.
    pkill -9 -f "$APPDIR/venv/bin/python.*multiprocessing" 2>/dev/null
    pkill -9 -f "$APPDIR/venv/bin/python.*stt_worker.py" 2>/dev/null
    if [ "$sujo" = 1 ] || [ "$forcar_reset" = reset ]; then
        sleep 1
        resetar_usb
    fi
}

# Espera o log mostrar que o sensor abriu de verdade ("Cor:" e' impresso depois
# de abrir + configurar o stream). Devolve 1 se o processo morreu ou travou
# (sensor pendurado nao imprime nada e fica com 0% de CPU).
esperar_sensor() {   # esperar_sensor <numero da tentativa>
    local i
    for i in $(seq 1 25); do
        sleep 1
        pgrep -f "$APP" >/dev/null 2>&1 || { fim_progresso; return 1; }
        grep -qE "(^| )Cor: " "$LOG" 2>/dev/null && { fim_progresso; return 0; }
        progresso "Abrindo o sensor (tentativa $1/3)... ${i}s/25s" "$i"
    done
    fim_progresso
    return 1
}

iniciar() {
    if [ ! -x "$PY" ] || [ ! -f "$APP" ]; then
        echo "ERRO: nao encontrei $PY ou $APP" >&2
        exit 1
    fi
    if pgrep -f "$APP" >/dev/null 2>&1; then
        echo "ja esta rodando (pid $(pgrep -f "$APP" | tr '\n' ' '))."
        return 0
    fi
    cd "$APPDIR" || exit 1
    esperar_usb || exit 1
    local tentativa
    for tentativa in 1 2 3; do
        # depois de uma falha o sensor passou por reset: espera ele reaparecer
        [ "$tentativa" -gt 1 ] && { esperar_usb 30 || exit 1; }
        # O PulseAudio (autostart no login) fica sondando a interface de audio
        # da PrimeSense e trava (usb_set_interface -110 no dmesg), o que deixa
        # o OpenNI2 pendurado ao abrir o video. Ele renasce sozinho quando o
        # mic pedir (pactl) — so precisa estar fora do caminho na abertura.
        pkill -9 pulseaudio 2>/dev/null
        nohup "$PY" -u "$APP" "$@" >"$LOG" 2>&1 &
        disown
        if esperar_sensor "$tentativa"; then
            echo "Tela aberta na Jetson (DISPLAY $DISP). Log: $LOG"
            return 0
        fi
        echo "tentativa $tentativa: sensor nao abriu; resetando USB..." >&2
        parar reset
        sleep 5
    done
    echo "Falha ao abrir. Ultimas linhas de $LOG:" >&2
    tail -n 20 "$LOG" >&2
    exit 1
}

case "${1:-}" in
    stop)
        parar; echo "Parado."
        ;;
    status)
        status
        ;;
    usb)
        esperar_usb "${2:-}"
        ;;
    start)
        shift
        iniciar "$@"
        ;;
    *)
        # sem argumento (ou algo que nao seja start/stop/status): reinicia
        parar
        iniciar "$@"
        ;;
esac
