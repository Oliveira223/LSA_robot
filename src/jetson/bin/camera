#!/usr/bin/env python3
"""
camera - terminal de controle do app da PrimeSense (Camera_Simples.py).

    camera                 abre o terminal interativo (prompt "camera> ")
    camera <comando> ...   roda um comando so e sai (ex.: camera saudar on)

Comandos que falam com o app em execucao (pelo socket /tmp/camera.sock, sem
reiniciar nada):  status, saudar, falar, digitar.
Comandos que mexem no processo (funcionam mesmo com o app travado, usam o
launcher camera-simples):  iniciar, reiniciar, parar, log.

So biblioteca padrao (Python 3.6 da Jetson).
"""
import cmd
import json
import os
import socket
import subprocess
import sys

AQUI = os.path.dirname(os.path.realpath(__file__))
LAUNCHER = os.path.join(AQUI, "camera-simples")
SOCKET = os.environ.get("CAMERA_SOCKET", "/tmp/camera.sock")   # CAMERA_SOCKET so pra testes
LOG = "/tmp/camera-simples.log"
TIMEOUT_S = 45.0          # `falar` espera a fala terminar
RUIDO_DO_LOG = ("depth:", "[transcritor] descartado")


def pedir(comando, arg=""):
    """Manda um comando ao app. Devolve (ok, mensagem)."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(TIMEOUT_S)
    try:
        s.connect(SOCKET)
        s.sendall((json.dumps({"cmd": comando, "arg": arg}) + "\n").encode("utf-8"))
        dados = b""
        while not dados.endswith(b"\n"):
            pedaco = s.recv(4096)
            if not pedaco:
                break
            dados += pedaco
        r = json.loads(dados.decode("utf-8"))
        return bool(r.get("ok")), str(r.get("msg", ""))
    except (FileNotFoundError, ConnectionRefusedError):
        return False, "o app nao esta rodando (abra com: iniciar)"
    except socket.timeout:
        return False, "o app nao respondeu a tempo (travado? tente: reiniciar)"
    except (OSError, ValueError) as e:
        return False, "falha ao falar com o app: %s" % e
    finally:
        s.close()


def launcher(*argumentos):
    """Roda o camera-simples (mostra a saida dele) e devolve o codigo de saida."""
    return subprocess.call([LAUNCHER] + list(argumentos))


class Terminal(cmd.Cmd):
    intro = "Controle da camera. 'ajuda' lista os comandos, 'sair' (ou Ctrl+D) fecha."
    prompt = "camera> "
    doc_header = "Comandos (digite 'ajuda <comando>' pra detalhes):"
    ruler = ""

    # ── falam com o app ────────────────────────────────────────────────
    def _remoto(self, comando, arg):
        ok, msg = pedir(comando, arg)
        print(msg if ok else "erro: " + msg)
        return None if ok else 1

    def do_status(self, arg):
        """status - estado do app: camera, profundidade, rostos, microfone, cerebro, saudacao."""
        return self._remoto("status", arg)

    def do_saudar(self, arg):
        """saudar [on|off|texto <frase>|dist <min> <max>|intervalo <s>]
        Sem argumento mostra o estado. Liga/desliga o "bom dia" quando um rosto
        chega perto, e ajusta frase, faixa de distancia (m) e intervalo (s)."""
        return self._remoto("saudar", arg)

    def complete_saudar(self, texto, linha, inicio, fim):
        return [o for o in ("on", "off", "texto", "dist", "intervalo") if o.startswith(texto)]

    def do_falar(self, arg):
        """falar <texto> - o robo fala o texto na caixa (testa a voz)."""
        return self._remoto("falar", arg)

    def do_digitar(self, arg):
        """digitar <texto> - injeta a frase como se tivesse sido falada: aparece na
        tela e vai pro cerebro (Jetson 1), que responde em texto e voz."""
        return self._remoto("digitar", arg)

    # ── mexem no processo ──────────────────────────────────────────────
    def do_iniciar(self, arg):
        """iniciar [flags] - abre o app se nao estiver rodando (flags vao pro
        Camera_Simples.py, ex.: iniciar --saudar)."""
        return launcher("start", *arg.split())

    def do_reiniciar(self, arg):
        """reiniciar [app|camera] [flags] - encerra o app do jeito limpo (SIGTERM, sem
        reset USB) e abre de novo. "camera" e "app" sao a mesma coisa: reabrir o
        sensor dentro do processo trava o OpenNI2. Ao reabrir, a saudacao volta
        ao padrao (desligada), a menos que voce passe --saudar."""
        partes = arg.split()
        if partes and partes[0] in ("app", "camera"):
            partes = partes[1:]
        return launcher(*partes)

    def do_parar(self, arg):
        """parar - encerra o app (SIGTERM, sem reset USB)."""
        return launcher("stop")

    def do_log(self, arg):
        """log [tudo] - acompanha o log do app ao vivo (Ctrl+C volta ao prompt).
        Sem "tudo" esconde as linhas de ruido (quadros de profundidade e falas descartadas)."""
        tudo = arg.strip() == "tudo"
        if not os.path.exists(LOG):
            print("erro: sem log em %s (o app ja foi aberto?)" % LOG)
            return 1
        proc = subprocess.Popen(["tail", "-n", "30", "-F", LOG], stdout=subprocess.PIPE,
                                universal_newlines=True, bufsize=1)
        try:
            for linha in proc.stdout:
                if tudo or not linha.startswith(RUIDO_DO_LOG):
                    print(linha, end="", flush=True)
        except KeyboardInterrupt:
            print()
        finally:
            proc.terminate()
        return None

    # ── terminal ───────────────────────────────────────────────────────
    def do_ajuda(self, arg):
        """ajuda [comando] - lista os comandos."""
        return self.do_help(arg)

    def do_sair(self, arg):
        """sair - fecha este terminal (o app continua rodando)."""
        return True

    def do_EOF(self, arg):       # Ctrl+D: quebra a linha do prompt e sai
        print()
        return True

    def get_names(self):         # esconde EOF da lista de ajuda (ele continua valendo)
        return [n for n in super().get_names() if n != "do_EOF"]

    def emptyline(self):
        pass

    def default(self, linha):
        print("comando desconhecido: %s  (digite 'ajuda')" % linha.split()[0])
        return 1

    def postcmd(self, stop, linha):
        return stop is True


def main():
    terminal = Terminal()
    if len(sys.argv) > 1:
        comando = " ".join(sys.argv[1:])
        if comando in ("-h", "--help"):
            print(__doc__)
            return 0
        if comando.split()[0] == "help":
            comando = "ajuda " + " ".join(comando.split()[1:])
        retorno = terminal.onecmd(comando)
        return retorno if isinstance(retorno, int) and not isinstance(retorno, bool) else 0
    try:
        terminal.cmdloop()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
