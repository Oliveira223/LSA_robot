#!/usr/bin/env python3
"""
camera - terminal de controle do app da PrimeSense (Camera_Simples.py).

    camera                 abre o terminal interativo (prompt "camera> ")
    camera <comando> ...   roda um comando so e sai (ex.: camera greet on)

Comandos que falam com o app em execucao (pelo socket /tmp/camera.sock, sem
reiniciar nada):  status, greet, say, type, listen, restart mic.
Comandos que mexem no processo (funcionam mesmo com o app travado, usam o
launcher camera-simples):  start, restart, stop, log.

`say` e `type` sem argumento abrem uma interface propria (um prompt que fica
esperando o texto); com argumento fazem a acao uma vez e saem.

So biblioteca padrao (Python 3.6 da Jetson).
"""
import cmd
import json
import os
import socket
import subprocess
import sys
import threading
import time

try:
    import readline      # so pra o input() ter edicao de linha e historico
except ImportError:
    readline = None

AQUI = os.path.dirname(os.path.realpath(__file__))
LAUNCHER = os.path.join(AQUI, "camera-simples")
SOCKET = os.environ.get("CAMERA_SOCKET", "/tmp/camera.sock")   # CAMERA_SOCKET so pra testes
LOG = "/tmp/camera-simples.log"
TIMEOUT_S = 45.0          # resposta de um comando normal
TIMEOUT_FALAR_S = 100.0   # `say` espera a fala terminar de tocar
TIMEOUT_RESPOSTA_S = 95.0 # `type <texto>` espera a resposta do robo
# apaga a linha atual (prompt/parcial) — so em terminal de verdade
LIMPA = "\r\033[K" if sys.stdout.isatty() else ""
RUIDO_DO_LOG = ("depth:", "[transcritor] descartado")

# subcomandos em ingles -> o que o app entende (o app fala portugues por dentro)
SUBCOMANDOS_GREET = {"text": "texto", "interval": "intervalo"}


def pedir(comando, arg="", timeout=TIMEOUT_S):
    """Manda um comando ao app. Devolve (ok, mensagem)."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET)
        s.sendall((json.dumps({"cmd": comando, "arg": arg}) + "\n").encode("utf-8"))
        dados = b""
        while not dados.endswith(b"\n"):
            pedaco = s.recv(4096)
            if not pedaco:
                break
            dados += pedaco
        r = json.loads(dados.decode("utf-8"))
        return bool(r.get("ok")), str(r.get("msg", ""))
    except (FileNotFoundError, ConnectionRefusedError):
        return False, "o app nao esta rodando (abra com: start)"
    except socket.timeout:
        return False, "o app nao respondeu a tempo (travado? tente: restart)"
    except (OSError, ValueError) as e:
        return False, "falha ao falar com o app: %s" % e
    finally:
        s.close()


def _novas(seq):
    """(ok, dict) com as mensagens do app depois de `seq`."""
    ok, msg = pedir("ouvir", str(seq))
    if not ok:
        return False, msg
    return True, json.loads(msg)


def _ancorar():
    """Numero da ultima mensagem de agora (so mostra o que vier depois), ou None."""
    ok, msg = pedir("ouvir", "-1")
    if not ok:
        print("erro: " + msg)
        return None
    return json.loads(msg)["seq"]


def _rotulo(autor, texto):
    return ("you: " if autor == "usuario" else "robot: ") + texto


def _imprimir_no_prompt(linha, prompt):
    """Imprime `linha` sem estragar o que a pessoa ja digitou no prompt."""
    digitado = readline.get_line_buffer() if readline else ""
    sys.stdout.write(LIMPA + linha + "\n" + prompt + digitado)
    sys.stdout.flush()


def launcher(*argumentos):
    """Roda o camera-simples (mostra a saida dele) e devolve o codigo de saida."""
    return subprocess.call([LAUNCHER] + list(argumentos))


def _ler_linha(prompt):
    """Uma linha do prompt, ou None em Ctrl+D/Ctrl+C."""
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None


def _limpar_doc(doc):
    """Tira o recuo comum das linhas de uma docstring."""
    linhas = doc.strip("\n").splitlines()
    resto = [l for l in linhas[1:] if l.strip()]
    recuo = min((len(l) - len(l.lstrip()) for l in resto), default=0)
    return "\n".join([linhas[0].strip()] + [l[recuo:] if l.strip() else "" for l in linhas[1:]])


class Terminal(cmd.Cmd):
    intro = "Controle da camera. 'help' explica os comandos, 'exit' (ou Ctrl+D) fecha."
    prompt = "camera> "
    doc_header = "Comandos (digite 'help <comando>' pra detalhes):"
    ruler = ""

    # nomes antigos em portugues: continuam funcionando, mas ficam fora do help
    _ALIASES = {"ajuda": "help", "saudar": "greet", "falar": "say", "digitar": "type",
                "conversar": "type", "transcrever": "listen", "iniciar": "start",
                "reiniciar": "restart", "parar": "stop", "sair": "exit"}

    def get_names(self):
        ocultos = {"do_EOF", "do_quit"}
        return [n for n in super().get_names() if n not in ocultos]

    def onecmd(self, linha):
        partes = linha.split(None, 1)
        if partes and partes[0] in self._ALIASES:
            linha = self._ALIASES[partes[0]] + (" " + partes[1] if len(partes) > 1 else "")
        return super().onecmd(linha)

    # ── falam com o app ────────────────────────────────────────────────
    def _remoto(self, comando, arg, timeout=TIMEOUT_S):
        ok, msg = pedir(comando, arg, timeout)
        print(msg if ok else "erro: " + msg)
        return None if ok else 1

    def do_status(self, arg):
        """status - mostra o estado de cada parte do app, numa olhada.

        Linhas: app (pid e ha quanto tempo roda), profundidade (se o sensor manda
        quadros; sem isso nao ha distancia), rostos (quantos no quadro agora), microfone
        (ok / SEM AUDIO / OFFLINE, com a causa provavel), transcricao, cerebro (Jetson 1
        conectada?), voz (robo = Piper da Jetson 1; local = servidor antigo) e saudacao.

        Use primeiro quando algo nao responde: ele diz o que esta quebrado e o que fazer.
        Nao altera nada."""
        return self._remoto("status", arg)

    def do_greet(self, arg):
        """greet [on|off|text <frase>|dist <min> <max>|interval <s>]

        Controla a saudacao: quando um rosto fica entre <min> e <max> metros por uns
        5 quadros seguidos, o robo fala a frase ("Bom dia" por padrao). Precisa da
        profundidade funcionando (sem ela nao ha distancia).

          greet                  mostra o estado atual
          greet on / greet off   liga / desliga (comeca desligada)
          greet text Oi, tudo bem?   muda a frase
          greet dist 0.8 1.2     faixa de distancia em metros (padrao 0.8 a 1.2)
          greet interval 20      segundos minimos entre duas saudacoes (padrao 20)

        Vale so enquanto o app roda: apos `restart` volta ao padrao (desligada),
        a menos que voce abra com `restart --saudar`."""
        partes = arg.split(None, 1)
        if partes and partes[0] in SUBCOMANDOS_GREET:
            partes[0] = SUBCOMANDOS_GREET[partes[0]]
            arg = " ".join(partes)
        return self._remoto("saudar", arg)

    def complete_greet(self, texto, linha, inicio, fim):
        return [o for o in ("on", "off", "text", "dist", "interval") if o.startswith(texto)]

    def do_say(self, arg):
        """say [texto] - faz o robo FALAR um texto, sem passar pelo cerebro.

          say bom dia            fala uma vez e volta
          say                    abre o modo say> : cada linha digitada e falada;
                                 "/exit" ou Ctrl+D volta ao camera>

        A voz e a do robo (Piper, sintetizada na Jetson 1 e tocada aqui na caixa HDMI);
        e a mesma das respostas. Se a Jetson 1 estiver fora ou com o servidor antigo,
        o comando avisa e tenta uma voz local (robotica). O microfone fica mudo enquanto
        o robo fala, pra ele nao ouvir a propria voz.
        Diferente de `type`: `say` repete o que voce escreveu; `type` PERGUNTA."""
        if arg.strip():
            return self._remoto("falar", arg, TIMEOUT_FALAR_S)
        print("Modo say: cada linha e falada pelo robo. '/exit' ou Ctrl+D sai.")
        while True:
            linha = _ler_linha("say> ")
            if linha is None or linha == "/exit":
                return None
            if linha:
                self._remoto("falar", linha, TIMEOUT_FALAR_S)

    def do_type(self, arg):
        """type [pergunta] - escreve pro robo como se voce tivesse FALADO. Vai ao cerebro
        (IA na Jetson 1), que responde em texto e voz. Serve pra conversar sem microfone.

          type qual e o seu nome     envia, mostra a resposta ("robot: ...") e volta
          type                       abre o modo type> : tudo que voce digitar vai ao cerebro
                                     e as respostas aparecem ali; "/exit" ou Ctrl+D volta

        A pergunta tambem aparece na janela de texto da tela do robo. Se a Jetson 1
        estiver desconectada, avisa que nao havera resposta.
        Diferente de `say`: `type` espera uma RESPOSTA; `say` so repete o texto."""
        if arg.strip():
            return self._perguntar(arg.strip())
        return self._conversar()

    def _perguntar(self, texto):
        """Envia uma pergunta e mostra a resposta do robo ate ela terminar."""
        seq = _ancorar()
        if seq is None:
            return 1
        ok, msg = pedir("digitar", texto)
        if not ok:
            print("erro: " + msg)
            return 1
        if "desconectada" in msg:
            print(msg)
        inicio = time.time()
        while time.time() - inicio < TIMEOUT_RESPOSTA_S:
            time.sleep(0.3)
            ok, d = _novas(seq)
            if not ok:
                print("erro: " + d)
                return 1
            seq = d["seq"]
            for autor, t in d["itens"]:
                if autor != "usuario":
                    print(_rotulo(autor, t), flush=True)
            if not d["aguardando"]:
                ok, d = _novas(seq)          # o fim pode ter chegado junto da ultima frase
                for autor, t in (d["itens"] if ok else []):
                    if autor != "usuario":
                        print(_rotulo(autor, t), flush=True)
                return None
        print("(o robo nao terminou de responder em %.0f s)" % TIMEOUT_RESPOSTA_S)
        return 1

    def _conversar(self):
        seq = _ancorar()
        if seq is None:
            return 1
        print("Modo type: tudo que voce digitar vai ao cerebro; o robo responde em texto e voz. "
              "'/exit' ou Ctrl+D sai.")
        pendentes = []                     # o que EU digitei, pra nao repetir o eco
        parar = threading.Event()

        def acompanhar(seq):
            while not parar.is_set():
                ok, d = _novas(seq)
                if not ok:
                    parar.wait(1.0)
                    continue
                seq = d["seq"]
                for autor, texto in d["itens"]:
                    if autor == "usuario" and texto in pendentes:
                        pendentes.remove(texto)
                        continue
                    _imprimir_no_prompt(_rotulo(autor, texto), "type> ")
                parar.wait(0.4)

        threading.Thread(target=acompanhar, args=(seq,), daemon=True).start()
        try:
            while True:
                linha = _ler_linha("type> ")
                if linha is None or linha == "/exit":
                    return None
                if not linha:
                    continue
                pendentes.append(linha)
                ok, msg = pedir("digitar", linha)
                if not ok:
                    pendentes.remove(linha)
                    print("erro: " + msg)
                elif "desconectada" in msg:
                    print(msg)
        finally:
            parar.set()

    def do_listen(self, arg):
        """listen - mostra no terminal, ao vivo, o que o microfone entende (e as respostas do robo).

        Cada frase falada aparece como "you: ..." depois que voce termina de falar; enquanto
        fala, uma linha "... texto parcial" vai se formando. Respostas do cerebro aparecem
        como "robot: ...". Ctrl+C volta ao prompt (o app continua).
        Se o microfone nao estiver ok, avisa antes de comecar. So observa, nao altera nada."""
        ok, msg = pedir("status")
        if ok:
            for linha in msg.splitlines():
                if linha.startswith("microfone:") and not linha.startswith("microfone: ok"):
                    print("aviso: " + linha)
        seq = _ancorar()
        if seq is None:
            return 1
        print("Ouvindo... (Ctrl+C sai)")
        try:
            while True:
                ok, d = _novas(seq)
                if not ok:
                    print(LIMPA + "erro: " + d)
                    return 1
                seq = d["seq"]
                for autor, texto in d["itens"]:
                    print(LIMPA + _rotulo(autor, texto), flush=True)
                print(LIMPA + ("  ... " + d["parcial"] if d["parcial"] else ""), end="", flush=True)
                time.sleep(0.4)
        except KeyboardInterrupt:
            print(LIMPA, end="")
        return None

    # ── mexem no processo ──────────────────────────────────────────────
    def do_start(self, arg):
        """start [flags] - abre o app da camera se ele nao estiver rodando (nao faz nada se ja estiver).

        Abre a janela em tela cheia na Jetson, liga camera, profundidade, deteccao de rosto,
        microfone e transcricao. Flags vao direto pro programa, por exemplo:
          start --saudar          abre com a saudacao ja ligada
          start --no-mic          sem microfone (da pra usar type/say)
          start --windowed        janela normal em vez de tela cheia
        Antes de abrir ele ESPERA a PrimeSense aparecer no USB (ate 60 s), mostrando
        "Procurando a PrimeSense no USB... tentativa N": se o cabo estiver desplugado, basta
        plugar e ele segue sozinho. Se nao aparecer, falha com instrucoes (replugar o cabo).
        Nao reinicia nada nem mexe no USB. Para reabrir um app ja rodando, use `restart`."""
        return launcher("start", *arg.split())

    def do_restart(self, arg):
        """restart mic - recria o ouvinte do microfone DENTRO do app, sem reabri-lo, e confere se
        chegou audio de verdade. Se o audio USB da PrimeSense travou, diz isso (so replug do
        cabo resolve; nesse caso use type/say enquanto isso).

        restart [app|camera] [flags] - encerra o app do jeito limpo (SIGTERM, ~5 s, sem reset
        USB) e abre de novo. "app" e "camera" sao a mesma coisa: reabrir o sensor dentro do
        processo trava o OpenNI2. A saudacao volta ao padrao (desligada), a menos que voce
        passe --saudar.

        Cuidado: reiniciar varias vezes seguidas pode travar o audio do sensor; prefira os
        comandos ao vivo (greet, say, type), que nao precisam reiniciar."""
        partes = arg.split()
        if partes and partes[0] == "mic":
            return self._remoto("reiniciar_mic", "")
        if partes and partes[0] in ("app", "camera"):
            partes = partes[1:]
        return launcher(*partes)

    def complete_restart(self, texto, linha, inicio, fim):
        return [o for o in ("mic", "app", "camera") if o.startswith(texto)]

    def do_stop(self, arg):
        """stop - encerra o app da camera do jeito limpo (SIGTERM, sem reset USB). Para abrir de novo: start."""
        return launcher("stop")

    def do_log(self, arg):
        """log [all] - acompanha o log do app ao vivo (equivale a um tail -f). Ctrl+C volta.

        Por padrao esconde o ruido (uma linha "depth:" a cada 5 s e falas descartadas pelo
        reconhecedor). `log all` mostra tudo. Mostra erros, avisos e eventos como
        "[saudacao] falando ..." e "[conversa] conectado ...". Util em um segundo terminal
        enquanto voce usa o primeiro."""
        tudo = arg.strip() in ("all", "tudo")
        if not os.path.exists(LOG):
            print("erro: sem log em %s (o app ja foi aberto?)" % LOG)
            return 1
        proc = subprocess.Popen(["tail", "-n", "30", "-F", LOG], stdout=subprocess.PIPE,
                                universal_newlines=True, bufsize=1)
        try:
            for linha in proc.stdout:
                if tudo or not linha.startswith(RUIDO_DO_LOG):
                    print(linha, end="", flush=True)
        except KeyboardInterrupt:
            print()
        finally:
            proc.terminate()
        return None

    VISAO_GERAL = """\
Conversar com o robo
  say [texto]         o robo FALA o texto (voz dele). Sem texto: modo say> (uma frase por linha)
  type [pergunta]     escreve pro robo como se voce tivesse falado; ele responde (texto e voz).
                      Sem pergunta: modo type> (chat)
  listen              mostra ao vivo o que o microfone ouve

Ver e ajustar (sem reiniciar nada)
  status              estado de camera, profundidade, rostos, microfone, cerebro e voz
  greet [...]         liga/desliga e ajusta o "bom dia" quando um rosto chega perto

O app da camera
  start [flags]       abre o app         stop         encerra o app
  restart [...]       reinicia o app, ou `restart mic` so o microfone
  log [all]           acompanha o log do app ao vivo

exit                  fecha este terminal (o app continua rodando)

Sem argumento, `say` e `type` abrem um prompt proprio; com argumento fazem a acao uma vez.
Digite 'help <comando>' pra detalhes e exemplos (ex.: help greet).
"""

    def do_help(self, arg):
        """help [comando] - esta ajuda; com um comando mostra os detalhes dele."""
        nome = arg.strip().split()[0] if arg.strip() else ""
        nome = self._ALIASES.get(nome, nome)
        if not nome:
            print(self.VISAO_GERAL)
            return None
        funcao = getattr(self, "do_" + nome, None)
        if funcao is None or not funcao.__doc__:
            print("comando desconhecido: %s  (digite 'help')" % nome)
            return 1
        print(_limpar_doc(funcao.__doc__))
        return None

    # ── terminal ───────────────────────────────────────────────────────
    def do_exit(self, arg):
        """exit - fecha este terminal (Ctrl+D tambem). O app da camera continua rodando."""
        return True

    do_quit = do_exit

    def do_EOF(self, arg):       # Ctrl+D: quebra a linha do prompt e sai
        print()
        return True

    def emptyline(self):
        pass

    def default(self, linha):
        print("comando desconhecido: %s  (digite 'help')" % linha.split()[0])
        return 1

    def postcmd(self, stop, linha):
        return stop is True


def main():
    terminal = Terminal()
    if len(sys.argv) > 1:
        comando = " ".join(sys.argv[1:])
        if comando in ("-h", "--help"):
            print(__doc__)
            return 0
        retorno = terminal.onecmd(comando)
        return retorno if isinstance(retorno, int) and not isinstance(retorno, bool) else 0
    try:
        terminal.cmdloop()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
